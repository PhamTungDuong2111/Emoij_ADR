<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Camera Preview View -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter"
        app:implementationMode="compatible" />

    <!-- AR Emoji Mask Overlay -->
    <com.randomvisual.emojimask.view.EmojiMaskOverlayView
        android:id="@+id/emojiMaskOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Flash Effect View for Shutter Snap -->
    <View
        android:id="@+id/shutterFlashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:visibility="gone" />

    <!-- Top Bar Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Language Switcher Button -->
        <LinearLayout
            android:id="@+id/btnLanguage"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_translate"
                app:tint="@color/color_primary" />

            <TextView
                android:id="@+id/tvCurrentLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/current_lang_badge"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Real-Time Face Expression Status Pill -->
        <LinearLayout
            android:id="@+id/expressionPill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnFlash"
            app:layout_constraintStart_toEndOf="@+id/btnLanguage"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Active Green Pulse Dot -->
            <View
                android:id="@+id/viewTrackingDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_shutter_inner"
                android:backgroundTint="@color/badge_green" />

            <TextView
                android:id="@+id/tvExpressionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/no_face_detected"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Flash Mode Toggle Button -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/flash_auto"
            android:src="@drawable/ic_flash_auto"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sub-bar Row: AR Mask Mode Toggle & Offline Badge -->
    <LinearLayout
        android:id="@+id/subBarRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <!-- Mask Mode Toggle Button (AR Cutout vs 2D Cartoon) -->
        <LinearLayout
            android:id="@+id/btnModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_glass_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvModeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_ar_cutout"
                android:textColor="@color/color_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Offline badge banner -->
        <TextView
            android:id="@+id/tvOfflineBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_glass_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/offline_badge"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Emoji Mask Carousel -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEmojiMasks"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            tools:listitem="@layout/item_emoji_mask" />

        <!-- Shutter & Flip Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="24dp">

            <!-- Empty balance space on left -->
            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Capture Shutter Button -->
            <FrameLayout
                android:id="@+id/btnCaptureShutter"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Outer Ring -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_shutter_ring" />

                <!-- Inner Button -->
                <View
                    android:id="@+id/shutterInnerCircle"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter_inner" />
            </FrameLayout>

            <!-- Flip Camera Button (Front/Back) -->
            <ImageButton
                android:id="@+id/btnFlipCamera"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/flip_camera"
                android:src="@drawable/ic_camera_switch"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- Camera Permission Prompt Card (Hidden by default) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPermissionPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/bg_surface_card"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎭"
                android:textSize="54sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/permission_camera_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/permission_camera_message"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantPermission"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:text="@string/grant_permission"
                android:textColor="@color/bg_dark"
                android:textStyle="bold"
                app:backgroundTint="@color/color_primary"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
